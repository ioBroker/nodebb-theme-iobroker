<div class="acp-page-container">
	<!-- IMPORT admin/partials/settings/header.tpl -->

	<div class="row m-0">
		<div id="spy-container" class="col-12 col-md-8 px-0 mb-4" tabindex="0">
			<form role="form" class="iobroker-settings">
				<div class="form-check form-switch">
					<input type="checkbox" class="form-check-input" id="enableQuickReply" name="enableQuickReply" />
					<label for="enableQuickReply" class="form-check-label">Enable quick reply</label>
				</div>
				<div class="form-check form-switch">
					<input type="checkbox" class="form-check-input" id="hideSubCategories" name="hideSubCategories" />
					<label for="hideSubCategories" class="form-check-label">Hide subcategories on categories view</label>
				</div>
				<div class="form-check form-switch">
					<input type="checkbox" class="form-check-input" id="hideCategoryLastPost" name="hideCategoryLastPost" />
					<label for="hideCategoryLastPost" class="form-check-label">Hide last post on categories view</label>
				</div>
			</form>
		</div>

		<!-- IMPORT admin/partials/settings/toc.tpl -->
	</div>
</div>
